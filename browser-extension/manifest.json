{
  "manifest_version": 3,
  "name": "Microsoft Rewards 青龙同步助手",
  "version": "3.0.2",
  "description": "管理多个 Rewards 账号的 Cookie 与 OAuth Token，并同步到用户自己的青龙。",
  "minimum_chrome_version": "102",
  "permissions": [
    "cookies",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://bing.com/*",
    "https://*.bing.com/*",
    "https://login.live.com/*",
    "https://prod.rewardsplatform.microsoft.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Microsoft Rewards 青龙同步"
  }
}
